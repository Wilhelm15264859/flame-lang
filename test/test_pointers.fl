extern func int printf(char* fmt);

func int sum_array(int* arr, int n) {
    var int s = 0;
    var int i = 0;
    while (i < n) {
        s = s + arr[i];
        i++;
    }
    return s;
}

func int main() {
    printf("=== pointer tests ===\n");

    var int arr[5];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 40;
    arr[4] = 50;

    var int s = sum_array(&arr[0], 5);
    printf("sum = %d\n", s);

    var int x = 42;
    var int* p = &x;
    *p = 99;
    printf("x after *p=99: %d\n", x);

    return 0;
}