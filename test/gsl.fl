#include "../libs/gsl/graphics.fl"

int main() {
    Window *win = openWindow("First", 600, 800);
    Shape *s = new(
        Circle,
        0, 0,
        200, 200,
        255, 255, 0, 255
    );
    Shape shapes[1];
    shapes[0] = *s;
    Screen *screen = new(
        &shapes, 1,
        255, 0, 0, 255
    );

    screen->set();
    screen->shapes[0].move(500, 0);
    screen->refresh();

    while (1) {
        if (appEvent() == Quit) {
            closeWindow(win);
            return 0;
        }
    }
    return 0;
}