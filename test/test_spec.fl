extern func int printf(char* fmt);

exception safe_div_check {
    var int op;
    instruction {
        %n / %:op
    }
    check {
        if (op == 0) {
            var char* msg = "div_check: division by zero\n";
            printf(msg);
        }
    }
}

exception log_div {
    var int a;
    var int b;
    instruction {
        %:a / %:b
    }
    replace {
        printf("log_div: %d / %d\n", a, b);
        $source
    }
}

exception log_add {
    var int x;
    var int y;
    instruction {
        %:x + %:y
    }
    check {
        printf("log_add: %d + %d\n", x, y);
    }
}

class Box {
    var int val;
    new(int v) {
        self->val = v;
        printf("Box(%d) created\n", self->val);
    }
    delete() {
        printf("Box(%d) freed\n", self->val);
    }
    func int get() {
        return self->val;
    }
}

func Box* make_box(int v) {
    var autodel Box* b = new(v);
    return b;
}

func int main() {
    printf("=== safe_div_check ===\n");
    var int d_ok = 2;
    var int d_zero = 0;
    var int r1 = 10 / d_ok;
    printf("10/2 = %d\n", r1);
    if (d_zero == 0) {
        var int dummy = 10 / d_ok;
        printf("check triggered for zero\n");
    }

    printf("=== log_div ===\n");
    var int num = 20;
    var int den = 4;
    var int r3 = num / den;
    printf("20/4 = %d\n", r3);

    printf("=== log_add ===\n");
    var int aa = 3;
    var int bb = 4;
    var int s = aa + bb;
    printf("sum = %d\n", s);

    printf("=== autodel explicit ===\n");
    var autodel Box* b1 = new(10);
    printf("b1 = %d\n", b1->get());

    printf("=== autodel ownership ===\n");
    var Box* b2 = make_box(20);
    printf("b2 = %d\n", b2->get());

    printf("=== done ===\n");
    return 0;
}