extern func int printf(char* fmt);

func int main() {
    printf("=== operator tests ===\n");

    var int a = 0xFF;
    var int b = 0x0F;
    printf("& = %d\n",  a & b);
    printf("| = %d\n",  a | b);
    printf("^ = %d\n",  a ^ b);
    printf("<< = %d\n", 1 << 4);
    printf(">> = %d\n", 256 >> 3);
    printf("~ = %d\n",  ~0);

    var int x = 10;
    x += 5;  printf("+=5: %d\n", x);
    x -= 3;  printf("-=3: %d\n", x);
    x *= 2;  printf("*=2: %d\n", x);
    x /= 4;  printf("/=4: %d\n", x);
    x %= 3;  printf("%%=3: %d\n", x);

    var float f = 3.14f;
    var float g = 2.0f;
    printf("float + : ok\n");

    var int t = (5 > 3) && (2 < 4);
    printf("&& = %d\n", t);
    var int u = (5 > 10) || (2 < 4);
    printf("|| = %d\n", u);
    var int v = !(0);
    printf("! = %d\n", v);

    return 0;
}