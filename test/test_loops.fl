extern func int printf(char* fmt);

class Box {
    var int val;
    new(int v) {
        self->val = v;
    }
    delete() {
        printf("Box(%d) destroyed\n", self->val);
    }
    func int get() {
        return self->val;
    }
}

func int main() {
    printf("=== loop tests ===\n");

    var int sum = 0;
    for (var int i = 0; i < 5; i++) {
        sum = sum + i;
    }
    printf("for sum 0..4 = %d\n", sum);

    var int n = 1;
    do while (n < 100) {
        n = n * 2;
    }
    printf("do-while: n = %d\n", n);

    printf("--- autodel in loop ---\n");
    var int i = 0;
    while (i < 3) {
        var autodel Box* b = new(i);
        printf("created Box(%d)\n", b->get());
        i++;
    }
    printf("after loop\n");

    return 0;
}