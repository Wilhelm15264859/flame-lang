extern func int printf(char* fmt);
extern func int scanf(char* fmt, int* val);

func int add(int a, int b) {
    return a + b;
}

func int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

func int fibonacci(int n) {
    if (n <= 1) {
        return n;
    }
    var int a = 0;
    var int b = 1;
    var int i = 2;
    while (i <= n) {
        var int tmp = a + b;
        a = b;
        b = tmp;
        i++;
    }
    return b;
}

func int main() {
    printf("=== basic tests ===\n");

    var int r = add(3, 4);
    printf("add(3,4) = %d\n", r);

    var int f = factorial(10);
    printf("factorial(10) = %d\n", f);

    var int fib = fibonacci(10);
    printf("fibonacci(10) = %d\n", fib);

    return 0;
}