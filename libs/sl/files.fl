#ifdef x86_64 #ifdef linux

int open(char *path, int flags) {
    int fd;

    x86_64 mov rax, 2;
    x86_64 mov rdi, $path;
    x86_64 mov rsi, $flags;
    x86_64 mov rdx, 0;
    x86_64 syscall ==> fd;

    return fd;
}
char *read(int fd, int len) {
    char *buf = malloc(len);

    x86_64 mov rax, 0;
    x86_64 mov rdi, $fd;
    x86_64 mov rsi, $buf;
    x86_64 mov rdx, $len;
    x86_64 syscall ==> buf;

    return buf;
}
void close(int fd) {
    x86_64 mov rax, 3;
    x86_64 mov rdi, $fd;
    x86_64 syscall;
}
void write( int len, int fd, char *str) {
    x86_64 mov rax, 1;
    x86_64 mov rdi, $fd;
    x86_64 mov rsi, $str;
    x86_64 mov rdx, $len;
    x86_64 syscall;
}
    
#endif #endif