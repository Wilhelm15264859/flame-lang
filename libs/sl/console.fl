#include "string.fl"

#ifdef x86_64 #ifdef linux

void out(char *msg) {
    int len = strlen(msg);

    x86_64 syscall
        : rcx r11
        < rax(1) rdi(1) rsi(msg) rdx(len);
}

char *in(int len) {
    char *buf;

    x86_64 mov rax, 0;
    x86_64 mov rdi, 0;
    x86_64 mov rsi, $buf;
    x86_64 mov rdx, $len;
    x86_64 syscall;

    return buf;
}

#endif #endif