func int strlen(char *str) {
    var int size = 0;
    
    for (var int i = 0; str[i] != '\0'; i++) {
        size++;
    }

    return size;
}

func char *strcat(char *str1, char *str2) {
    var int size1 = strlen(str1);
    var int size2 = strlen(str2);

    var char *sum = malloc(size1 + size2 + 1);

    for (var int i = 0; i < size1; i++) {
        sum[i] = str1[i];
    }
    for (var int i = 0; i < size2; i++) {
        sum[size1 + i] = str2[i];
    }
    sum[size1 + size2] = '\0';

    return sum;
}

func int strcmp(char *str1, char *str2) {
    var int len1 = strlen(str1);
    var int len2 = strlen(str2);

    if (len1 == len2)
        for (var int i = 0; i < len1; i++) 
            if (str1[i] != str2[i]) return 0;
    else
        return 0;

    return 1;
}