int strlen(char *str) {
    int size = 0;
    
    for (int i = 0; str[i] != '\0'; i++) {
        size++;
    }

    return size;
}

char *strcat(notdel char *str1, notdel char *str2) {
    int size1 = strlen(str1);
    int size2 = strlen(str2);

    char *sum = malloc(size1 + size2 + 1);

    for (int i = 0; i < size1; i++) {
        sum[i] = str1[i];
    }
    for (int i = 0; i < size2; i++) {
        sum[size1 + i] = str2[i];
    }
    sum[size1 + size2] = '\0';

    delete() str1;
    delete() str2;
    return sum;
}

int strcmp(char *str1, char *str2) {
    int len1 = strlen(str1);
    int len2 = strlen(str2);

    if (len1 == len2)
        for (int i = 0; i < len1; i++) 
            if (str1[i] != str2[i]) return 0;
    else 
        return 0;

    return 1;
}